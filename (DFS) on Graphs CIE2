g = [[1, 2], [0, 3, 4], [0, 5],
 [1], [1], [2]]
visited = [0] * 6
stack = [0]
print("DFS Traversal:", end=" ")
while stack:
 u = stack.pop()
 if not visited[u]:
 visited[u] = 1
 print(u, end=" ")
 for v in reversed(g[u]):
 if not visited[v]:
 stack.append(v)
print()
Expected Output
DFS Traversal: 0 1 3 4 2 5
