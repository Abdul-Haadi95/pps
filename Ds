Q7. Stack using Array
python
stack = []

def push(item):
    stack.append(item)

def pop():
    if not stack:
        print("Stack Underflow")
    else:
        return stack.pop()

def peek():
    if not stack:
        print("Stack is Empty")
    else:
        return stack[-1]

def display():
    print("Stack:", stack)

push(10)
push(20)
push(30)
display()
print("Popped:", pop())
print("Peek:", peek())
display()

Output:
Stack: [10, 20, 30]
Popped: 30
Peek: 20
Stack: [10, 20]
