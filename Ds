Q2. Binary Search

def binary_search(arr, key):
    low, high = 0, len(arr) - 1
    while low <= high:
        mid = (low + high) // 2
        if arr[mid] == key:
            return mid
        elif arr[mid] < key:
            low = mid + 1
        else:
            high = mid - 1
    return -1

arr = [11, 15, 23, 45, 70, 90]
key = 45
result = binary_search(arr, key)
if result != -1:
    print("Element found at index", result)
else:
