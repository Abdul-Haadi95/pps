Q6. Quick Sort
def quick_sort(arr):
    if len(arr) <= 1:
        return arr
    pivot = arr[len(arr) // 2]
    left = [x for x in arr if x < pivot]
    mid = [x for x in arr if x == pivot]
    right = [x for x in arr if x > pivot]
    return quick_sort(left) + mid + quick_sort(right)

arr = [10, 7, 8, 9, 1, 5]
print("Sorted array:", quick_sort(arr))

Output:
Sorted array: [1, 5, 7, 8, 9, 10]
