def find(p, x):
 while p[x] != x:
 x = p[x]
 return x
n = 5
edges = [(10,0,1), (20,0,2), (30,0,3),
 (40,0,4), (2,1,2), (3,1,3),
 (4,1,4), (1,2,3), (2,2,4),
 (3,3,4)]
edges.sort()
p = list(range(n))
total = 0
print("Edges in MST:")
for w, u, v in edges:
 a, b = find(p, u), find(p, v)
 if a != b:
 print(u, "-", v, ":", w)
 p[a] = b
 total += w
print("Minimum Cost =", total)
